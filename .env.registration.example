# Copy to .env.registration (gitignored). Never paste provider credentials in chat.
# Single-quote credentials containing $ to prevent Compose interpolation.
# Real delivery: use an approved LIVE SMS.ir verification template and relay.
SMS_GATEWAY_API_KEY=
SMS_IR_TEMPLATE_ID=
# Exact parameter name, without # delimiters.
SMS_IR_CODE_PARAMETER=
# Independent base64-encoded 32-byte secret. Keep stable across restarts/updates.
SMS_OTP_HASH_PEPPER=
# Explicit local spend/admission choices. Set all four positive integer values;
# no live spend is authorized by copying this example.
SMS_OTP_GLOBAL_PER_DAY=
REGISTRATION_PENDING_CAPACITY=
REGISTRATION_GLOBAL_DAILY_LIMIT=
REGISTRATION_EMAIL_HOURLY_LIMIT=

# Username policy configuration does not install or open the database authority.
# Activation and the target baseline inventory require separate approval.
USERNAME_ENABLED=true
USERNAME_REGEX='[\x{0621}\x{0622}\x{0624}\x{0626}-\x{0628}\x{062A}-\x{063A}\x{0641}-\x{0648}\x{064A}\x{067E}\x{0686}\x{0698}\x{06A9}\x{06AF}\x{06CC}]+(?:\.[\x{0621}\x{0622}\x{0624}\x{0626}-\x{0628}\x{062A}-\x{063A}\x{0641}-\x{0648}\x{064A}\x{067E}\x{0686}\x{0698}\x{06A9}\x{06AF}\x{06CC}]+)*'
# Explicit owner-reviewed artifact and reserved_names; see registration-contract.
USERNAME_POLICY_JSON=
# Independent stable base64 secret >=32 bytes, not the email/phone pepper.
USERNAME_LOOKUP_KEY=
USERNAME_LOOKUP_KEY_ID=

# Authenticated TLS relay; SMTPUTF8 MUST be advertised after TLS.
REGISTRATION_SMTP_HOST=
REGISTRATION_SMTP_PORT=587
REGISTRATION_SMTP_TLS_MODE=starttls
REGISTRATION_SMTP_USERNAME=
REGISTRATION_SMTP_PASSWORD=
REGISTRATION_SMTP_FROM=

# Independent URL-safe password, 32..128 characters from A-Z a-z 0-9 _ -.
# Example generation command (run privately): openssl rand -hex 32
# The local role setup creates its role once; it never rotates an existing password.
REGISTRATION_CLEANUP_PASSWORD=
