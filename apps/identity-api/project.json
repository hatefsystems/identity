{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "identity-api",
  "projectType": "application",
  "sourceRoot": "apps/identity-api",
  "implicitDependencies": ["schemas"],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/libs/schemas/proto/**/*",
      "{workspaceRoot}/libs/schemas/buf*.yaml",
      "{workspaceRoot}/libs/schemas/go.mod",
      "{workspaceRoot}/libs/schemas/go.sum"
    ]
  },
  "tags": ["lang:go", "scope:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/identity-api ./cmd/server"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "build-purge-worker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/purge-worker ./cmd/purge-worker"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "build-audit-signer": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/audit-signer ./cmd/audit-signer"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "build-portal-fixture": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -tags=portalfixture -o bin/portal-fixture ./cmd/portal-fixture"
      },
      "dependsOn": ["sqlc-generate"],
      "outputs": ["{projectRoot}/bin/portal-fixture"],
      "cache": true
    },
    "test-portal-fixture": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -tags=portalfixture -count=1 ./cmd/portal-fixture"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-portal": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -count=1 ./internal/config ./internal/profile ./internal/session ./internal/server ./internal/webauthn ./internal/recovery ./internal/stepup ./internal/oidc/dpop ./internal/oidc/token ./internal/lifecycle ./internal/identitygrpc"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-webauthn": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -count=1 ./internal/webauthn"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-portal-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','REDIS_URL','NATS_URL']) if (!process.env[k]?.trim()) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/profile','./internal/session','./internal/server','./internal/webauthn','./internal/recovery','./internal/stepup','./internal/oidc/dpop','./internal/oidc/token','./internal/lifecycle','./internal/identitygrpc'], {stdio:'inherit',env:{...process.env,REQUIRE_PORTAL_INTEGRATION:'1',REQUIRE_PROFILE_INTEGRATION:'1',REQUIRE_GRPC_INTEGRATION:'1',REQUIRE_LIFECYCLE_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false,
      "parallelism": false
    },
    "build-security-ledger-purge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/security-ledger-purge ./cmd/security-ledger-purge"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "security-ledger-purge": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/security-ledger-purge"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "build-admin-audit-publisher": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/admin-audit-publisher ./cmd/admin-audit-publisher"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "admin-audit-publisher": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/admin-audit-publisher"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "build-lifecycle-publisher": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/lifecycle-publisher ./cmd/lifecycle-publisher"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "lifecycle-publisher": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/lifecycle-publisher"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-lifecycle": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -count=1 ./internal/lifecycle"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "test-lifecycle-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','NATS_URL']) if (!process.env[k]?.trim()) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/lifecycle'], {stdio:'inherit',env:{...process.env,REQUIRE_LIFECYCLE_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false,
      "parallelism": false
    },
    "build-admin-roles": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/admin-roles ./cmd/admin-roles"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "admin-roles": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/admin-roles"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "sqlc-generate": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["schemas"], "target": "generate-go" }],
      "options": {
        "cwd": "apps/identity-api",
        "command": "go tool sqlc generate"
      },
      "inputs": [
        "{projectRoot}/sqlc.yaml",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/db/queries/**/*.sql"
      ],
      "outputs": ["{projectRoot}/internal/db"],
      "cache": true
    },
    "sqlc-vet": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go tool sqlc vet"
      }
    },
    "migrate-up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate up"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate down"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate status"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/server"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "purge-worker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/purge-worker"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "audit-signer": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/audit-signer"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -count=1 ./..."
      },
      "dependsOn": ["sqlc-generate", "^build"],
      "cache": true
    },
    "test-race": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -race -count=1 ./..."
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-security-db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "commands": [
          "node -e \"if (!process.env.DATABASE_URL) { throw new Error('DATABASE_URL is required') }\"",
          "go test -tags=integration -count=1 -p=1 ./internal/dbintegration ./internal/recovery ./internal/webauthn ./internal/privacy ./internal/server ./internal/audit/signer ./internal/natsjs ./internal/pglock ./internal/rbac ./internal/legalhold ./internal/adminaction ./internal/session ./internal/legalpolicy ./internal/legalworkflow ./internal/legalreport"
        ],
        "parallel": false
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-admin-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','REDIS_URL','NATS_URL']) if (!process.env[k]) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/adminaction','./internal/legalhold','./internal/rbac','./internal/session','./internal/server','./internal/audit/signer','./internal/pglock'], {stdio:'inherit',env:{...process.env,REQUIRE_ADMIN_AUDIT_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-grpc-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','REDIS_URL']) if (!process.env[k]?.trim()) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/identitygrpc','./internal/session','./internal/oidc/token','./internal/oidc/dpop'], {stdio:'inherit',env:{...process.env,REQUIRE_GRPC_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-retention-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','REDIS_URL','NATS_URL']) if (!process.env[k]?.trim()) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/audit/retention','./internal/audit/ledgerproof','./internal/retentiondbintegration'], {stdio:'inherit',env:{...process.env,REQUIRE_RETENTION_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-legal-workflow-integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "node -e \"for (const k of ['DATABASE_URL','REDIS_URL','NATS_URL']) if (!process.env[k]?.trim()) throw new Error(k + ' is required'); const r = require('child_process').spawnSync('go', ['test','-tags=integration','-count=1','-p=1','./internal/legalpolicy','./internal/legalworkflow','./internal/legalreport','./internal/server'], {stdio:'inherit',env:{...process.env,REQUIRE_LEGAL_WORKFLOW_INTEGRATION:'1',REQUIRE_ADMIN_AUDIT_INTEGRATION:'1'}}); if(r.error) throw r.error; process.exit(r.status ?? 1)\""
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "golangci-lint run ./..."
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "vet": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go vet ./..."
      },
      "dependsOn": ["sqlc-generate"]
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go mod tidy"
      }
    },
    "build-admin-legal": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/admin-legal ./cmd/admin-legal"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "admin-legal": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/admin-legal"
      },
      "dependsOn": ["sqlc-generate"]
    }
  }
}
