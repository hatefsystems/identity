{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "identity-api",
  "projectType": "application",
  "sourceRoot": "apps/identity-api",
  "tags": ["lang:go", "scope:backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/identity-api ./cmd/server"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "build-purge-worker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go build -o bin/purge-worker ./cmd/purge-worker"
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "sqlc-generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go tool sqlc generate"
      },
      "inputs": [
        "{projectRoot}/sqlc.yaml",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/db/migrations/**/*.sql",
        "{projectRoot}/db/queries/**/*.sql"
      ],
      "outputs": ["{projectRoot}/internal/db"],
      "cache": true
    },
    "sqlc-vet": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go tool sqlc vet"
      }
    },
    "migrate-up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate up"
      }
    },
    "migrate-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate down"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/migrate status"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/server"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "purge-worker": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go run ./cmd/purge-worker"
      },
      "dependsOn": ["sqlc-generate"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -count=1 ./..."
      },
      "dependsOn": ["sqlc-generate", "^build"],
      "cache": true
    },
    "test-race": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go test -race -count=1 ./..."
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "test-security-db": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "commands": [
          "node -e \"if (!process.env.DATABASE_URL) { throw new Error('DATABASE_URL is required') }\"",
          "go test -tags=integration -count=1 -p=1 ./internal/dbintegration ./internal/recovery ./internal/webauthn ./internal/privacy ./internal/server"
        ],
        "parallel": false
      },
      "dependsOn": ["sqlc-generate"],
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "golangci-lint run ./..."
      },
      "dependsOn": ["sqlc-generate"],
      "cache": true
    },
    "vet": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go vet ./..."
      },
      "dependsOn": ["sqlc-generate"]
    },
    "tidy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/identity-api",
        "command": "go mod tidy"
      }
    }
  }
}
