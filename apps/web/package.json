{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "typecheck": {
        "command": "tsc --noEmit --project apps/web/tsconfig.spec.json",
        "dependsOn": [
          "^build"
        ],
        "cache": true
      },
      "test-portal-browser": {
        "command": "node .github/scripts/web-portal.browser.mjs",
        "dependsOn": [
          "build",
          { "projects": ["identity-api"], "target": "build" },
          { "projects": ["identity-api"], "target": "build-portal-fixture" },
          { "projects": ["identity-api"], "target": "build-deletion-notifier" }
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@hatef/ui": "*",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
