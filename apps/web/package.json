{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "page-gallery": {
        "command": "node tools/page-gallery/generate-page-gallery.mjs",
        "dependsOn": [],
        "cache": false,
        "parallelism": false
      },
      "check-page-gallery": {
        "command": "node tools/page-gallery/generate-page-gallery.mjs --check",
        "dependsOn": [],
        "cache": false,
        "parallelism": false
      },
      "test-page-gallery": {
        "command": "node --test tools/page-gallery/*.test.mjs .github/scripts/*.test.mjs",
        "dependsOn": [],
        "cache": false,
        "parallelism": false
      },
      "test-registration-browser": {
        "command": "node -e \"if (!/^sha256:[0-9a-f]{64}$/.test(process.env.REGISTRATION_BROWSER_API_IMAGE || '')) throw new Error('Immutable REGISTRATION_BROWSER_API_IMAGE is required'); const r = require('child_process').spawnSync(process.execPath, ['.github/scripts/registration-browser.mjs'], {stdio:'inherit'}); if(r.error) throw r.error; process.exit(r.status ?? 1)\"",
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "parallelism": false
      },
      "typecheck": {
        "command": "tsc --noEmit --project apps/web/tsconfig.spec.json",
        "dependsOn": [
          "^build"
        ],
        "cache": true
      },
      "test-portal-browser": {
        "command": "node .github/scripts/web-portal.browser.mjs",
        "dependsOn": [
          "build",
          {
            "projects": [
              "identity-api"
            ],
            "target": "build"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-portal-fixture"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-deletion-notifier"
          }
        ],
        "cache": false
      },
      "test-admin-browser": {
        "command": "node .github/scripts/web-admin.browser.mjs",
        "dependsOn": [
          "build",
          {
            "projects": [
              "identity-api"
            ],
            "target": "build"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-portal-fixture"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-deletion-notifier"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-audit-signer"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-admin-audit-publisher"
          },
          {
            "projects": [
              "identity-api"
            ],
            "target": "build-admin-legal"
          }
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@hatef/ui": "*",
    "next": "~16.1.6",
    "next-intl": "4.14.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22"
  }
}
