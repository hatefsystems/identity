# Copy to .env.production; keep private (chmod 600). No usable secrets supplied.
# API and web must identify a matching release; prefer digests from Actions summary.
API_IMAGE=ghcr.io/hatefsystems/identity-api:1.2.3
WEB_IMAGE=ghcr.io/hatefsystems/identity-web:1.2.3
POSTGRES_USER=identity_owner
POSTGRES_DB=identity
POSTGRES_PASSWORD=
# Separate API role provisioned by the operator with the documented grants.
# URL-encode passwords in DSNs. Internal service DNS names, never localhost.
MIGRATION_DATABASE_URL=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
APP_ENV=production
PORTAL_ORIGIN=https://identity.example.com
OIDC_ISSUER=https://identity.example.com
WEBAUTHN_RP_ID=identity.example.com
WEBAUTHN_RP_ORIGINS=https://identity.example.com
# Exact observed Nginx socket peer, not a broad Docker/public CIDR.
TRUSTED_PROXY_CIDRS=
# Independent private base64 keys: KEK exactly 32 bytes; other keys >=32 bytes.
ENVELOPE_MASTER_KEK=
ENVELOPE_MASTER_KEK_VERSION=1
ENVELOPE_BLIND_INDEX_PEPPER=
ENVELOPE_BLIND_INDEX_PEPPER_VERSION=0
WEBAUTHN_MOCK_CHALLENGE_KEY=
STEPUP_REPLAY_HMAC_KEY=
# Compose env files accept single-quoted multiline PEM values. Inject private keys
# from the approved secrets manager; active/next ES256 or RS256, previous optional.
OIDC_SIGNING_KEY_ACTIVE_PEM=
OIDC_SIGNING_KEY_NEXT_PEM=
OIDC_SIGNING_KEY_PREVIOUS_PEM=
# Nonempty approved registry; see .env.example and docs/client-integration.md.
OIDC_CLIENTS_JSON=
# Optional capabilities are off in the base Compose file. Activate them only
# through reviewed service overrides, with their required configuration/workers.
