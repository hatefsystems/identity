# Hatef Identity Platform - local development environment template.
#
# Copy this file to `.env` (which is gitignored) and adjust as needed:
#   cp .env.example .env
#
# These values feed docker-compose.dev.yml and the Go identity-api service for
# LOCAL DEVELOPMENT ONLY. Never commit real secrets. In deployed environments,
# secrets are injected at runtime by the KMS/secrets manager (Infisical) per
# the DevOps playbook and Definition of Done #3.

# --- HTTP / Trusted Reverse Proxies -----------------------------------------
# APP_ENV is mandatory: exactly development, test, or production. Unset, empty,
# padded and unknown values fail before connections/listeners are started.
# Only explicit development allows local conveniences, never test/production.
APP_ENV=development
# One canonical browser origin for pages AND /api, without trailing slash/path,
# query, fragment, or an explicit default port. Must match OIDC_ISSUER's origin
# and a WEBAUTHN_RP_ORIGINS entry. HTTPS is required outside explicit loopback
# development. This example needs a local TLS ingress on 8443 routing pages to
# Next on 3000 and /api directly to Go on 8080. Separate browser/API origins are
# not supported; do not add CORS or a cookie-only/BFF workaround.
PORTAL_ORIGIN=https://localhost:8443
# Keep hardened cookies for local HTTPS and production browser acceptance.
# Plain HTTP experimentation requires APP_ENV=development, a loopback HTTP origin,
# SESSION_COOKIE_SECURE=false and a non-__Host- cookie name. Never use those
# overrides in deployed environments or to bypass browser acceptance checks.
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=true
SESSION_ABSOLUTE_TTL=24h
SESSION_IDLE_TTL=2h
# Old cookies without a DPoP binding require fresh passkey login at cutover.
# Only successful authorized browser requests renew activity; OAuth refresh/RPC
# validation and denied proofs do not. The portal does not poll to keep it alive.

# Comma-separated CIDRs of the immediate reverse proxies allowed to assert the
# X-Forwarded-For client chain. Empty is the secure local-development default:
# all forwarding headers are ignored and the socket peer is used. Configure
# only exact ingress networks in deployed environments; never use 0.0.0.0/0 or
# ::/0 (both are rejected at startup). Nginx must overwrite X-Forwarded-For
# with $remote_addr. The API ignores X-Real-IP/True-Client-IP, accepts at most
# 16 XFF entries, and walks a trusted chain right-to-left to the first untrusted
# address. For host Nginx over loopback use 127.0.0.1/32 only when that is the
# API's actual socket peer; do not expose the API port directly.
TRUSTED_PROXY_CIDRS=

# --- PostgreSQL -------------------------------------------------------------
# Forward-only bundle: unchanged 00001_initial_schema.sql plus additive
# 00002_registration_attempts.sql records version 2 in
# public.identity_schema_version. ALL legacy public.goose_db_version targets,
# untracked nonempty application schemas and contradictory histories are refused.
# These names/ports are examples, not permission to reuse/reset an existing stack.
# Select an explicitly scoped fresh PostgreSQL 16 target plus matching isolated
# Redis 7/NATS JetStream 2.10 state; stop all old writers before switching.
# All existing Identity data was confirmed disposable, but any existing-environment
# reset still requires separate explicit authorization naming the exact targets.
# Never broadly delete volumes, adopt/stamp history or run down/reset to install.
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity_dev_password
POSTGRES_DB=identity
POSTGRES_PORT=5432
# Connection string the Go backend can consume (pgx / sqlc).
DATABASE_URL=postgres://identity:identity_dev_password@127.0.0.1:5432/identity?sslmode=disable

# --- Redis ------------------------------------------------------------------
# Leave REDIS_PASSWORD empty to run Redis without auth locally, or set a value
# to enable --requirepass (the compose healthcheck adapts automatically).
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
# Also authoritative for browser sessions, OAuth grants/codes, browser DPoP
# nonce/replay state, and versioned shared WebAuthn challenges across replicas.
# Missing/evicted credential state requires reauthentication, not reconstruction.
# Challenge loss requires a new ceremony; Redis errors never fall back to memory.

# --- NATS JetStream ---------------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222
# Consumed by the Go backend for the async audit pipeline (Task 5.2 — see the
# "Audit Pipeline" section below). REQUIRED outside development: without it there
# is no durable audit trail. In development an empty value falls back to a
# log-only recorder so the service still boots with no message bus running.
NATS_URL=nats://127.0.0.1:4222

# --- Metadata-only user lifecycle broadcast (Task 6.3) -----------------------
# Separate from the audit stream. Provision explicitly before starting the worker.
# Development retention defaults require an explicit APP_ENV=development.
# Production must set approved finite retention values; these are local examples,
# NOT approval to retain linkable user IDs for seven days in production.
LIFECYCLE_STREAM_NAME=IDENTITY_USERS
LIFECYCLE_STREAM_MAX_BYTES=134217728
# LIFECYCLE_STREAM_MAX_AGE=168h
# LIFECYCLE_OUTBOX_RETENTION=168h
LIFECYCLE_BATCH_SIZE=50
LIFECYCLE_PUBLISH_TIMEOUT=5s
LIFECYCLE_BATCH_TIMEOUT=30s
LIFECYCLE_POLL_INTERVAL=1s
LIFECYCLE_STARTUP_TIMEOUT=15s
# Cleanup is explicit, separately credentialed and DB-only. Never reuse API/admin
# credentials here. Unpublished, active-held and malformed rows are not deleted.
LIFECYCLE_CLEANUP_DATABASE_URL=
LIFECYCLE_CLEANUP_BATCH_SIZE=500

# --- Application-Layer Envelope Encryption (Task 2.3) -----------------------
# LOCAL DEVELOPMENT ONLY. In test/production these are injected at runtime
# by the KMS/secrets manager (Infisical) per docs/devops-operations.md §2.1.
# NEVER commit real key material. Regenerate your own local values, e.g.:
#   openssl rand -base64 32
#
# Master Key Encryption Key (KEK): base64-encoded, must decode to exactly 32
# bytes (AES-256). Wraps the per-record Data Encryption Keys (DEKs).
ENVELOPE_MASTER_KEK=REPLACE_WITH_INDEPENDENT_BASE64_32_BYTE_KEK
# Version byte stamped into every envelope blob (0-255) for KEK rotation.
ENVELOPE_MASTER_KEK_VERSION=1
# Secret pepper for the SHA-256 blind index: base64-encoded, >=32 bytes.
ENVELOPE_BLIND_INDEX_PEPPER=REPLACE_WITH_INDEPENDENT_BASE64_32_BYTE_PEPPER
# The known public all-zero 32-byte sample is rejected in production. No runtime
# key generation/rotation occurs; retained ciphertext needs its original KEKs.
ENVELOPE_BLIND_INDEX_PEPPER_VERSION=0
# The generic BlindIndex uses lowercase(NFKC(trim(identity))) unchanged. Mailbox
# identity instead uses NFC/lower/NFC plus strict IDNA and exact canonical
# storage/delivery/lookup: NFKC-distinct mailboxes must remain distinct. Capture
# records the pepper generation; the browser never hashes identities. The process
# loads one KEK/version and one pepper/version, without live Infisical fetching,
# cache fallback, historical-key lookup or hot rotation. Retain retired backup keys.

# --- OIDC / OAuth2 Signing Keys (Task 3.1) ----------------------------------
# The issuer is the canonical URL identifying this IdP; it is embedded in the
# discovery document (/.well-known/openid-configuration) and all issued tokens.
# In development it defaults to http://localhost:8080 when unset; outside
# development it is REQUIRED and must be an https URL. Query/fragment markers,
# including bare ? and #, userinfo and malformed hosts/ports are rejected.
OIDC_ISSUER=https://localhost:8443
#
# Private IdentityService (Task 6.2). Disabled unless explicitly configured.
# Enabling requires PostgreSQL, Redis and a usable local SPIRE Workload API.
# There is no plaintext, static-certificate or public-ingress fallback.
GRPC_ENABLED=false
GRPC_ADDR=127.0.0.1:9090
GRPC_TRUST_DOMAIN=
SPIFFE_ENDPOINT_SOCKET=
GRPC_METHOD_GRANTS_JSON={}
GRPC_VALIDATION_POLICIES_JSON={}
GRPC_REQUEST_TIMEOUT=2s
# Grant keys are exact /hatef.identity.v1.IdentityService/Method names; values
# are arrays of approved SPIFFE IDs. Validation policies are keyed by that ID
# and contain audiences and canonical resource origins. Empty maps deny all.
# See docs/client-integration.md for a complete, non-production example.
#
# Signing keys back the graceful 3-key JWKS rotation cycle (active/next/previous)
# served at /oauth2/jwks. Provide PEM-encoded PRIVATE keys, RS256 (>=2048-bit
# RSA) or ES256 (NIST P-256) only — symmetric algorithms are prohibited.
#
# LOCAL DEVELOPMENT ONLY: if these are left empty in the development environment
# the server generates ephemeral ES256 keys at startup (process-local, never
# persisted). Outside development, OIDC_SIGNING_KEY_ACTIVE_PEM and
# OIDC_SIGNING_KEY_NEXT_PEM are REQUIRED and injected by the KMS (Infisical).
# The PREVIOUS slot is optional (empty on a fresh deployment). Generate a local
# ES256 key with:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Multi-line PEM values must be provided as-is (e.g. via docker/compose env files
# or the KMS); shell `.env` files do not support raw newlines in a value.
OIDC_SIGNING_KEY_ACTIVE_PEM=
OIDC_SIGNING_KEY_NEXT_PEM=
OIDC_SIGNING_KEY_PREVIOUS_PEM=

# --- OIDC Client Registry (Task 3.2) ----------------------------------------
# Clients are registered via static config / IaC only — there is no public
# developer portal (docs/architecture.md "Secure Client Authentication"). The
# authorization endpoint (/oauth2/auth) resolves the client_id, exact-matches
# the redirect_uri, and enforces the client's allowed scopes from this list.
#
# JSON array of client definitions. Each entry:
#   client_id                   : unique client identifier
#   redirect_uris               : exact-match allow-list (no wildcards/prefixes)
#                                 structural HTTPS URLs; only explicit development
#                                 allows canonical localhost/loopback HTTP. Test
#                                 is not a dev exception; fragments/userinfo/opaque
#                                 URLs and malformed hosts/ports are rejected.
#   token_endpoint_auth_method  : "none" (public) or "private_key_jwt" (confidential)
#   allowed_scopes              : scopes the client may request (must include "openid")
#   jwks                        : REQUIRED for private_key_jwt clients — a JWK Set
#                                 ({"keys":[...]}) of the client's PUBLIC verification
#                                 keys (RS256 >=2048-bit RSA or ES256 P-256 only).
#                                 MUST be omitted/empty for "none" (public) clients.
#
# Confidential internal services (Search Engine, Email Service) authenticate to
# /oauth2/token via RFC 7523 private_key_jwt (Task 3.4): they present a short-lived
# JWT assertion signed with their PRIVATE key, verified here against the PUBLIC
# keys in "jwks". No shared secrets are ever stored (docs/architecture.md
# "Secure Client Authentication"). Generate a client key pair, then publish only
# the public JWK here; the private key lives with the client (injected by the KMS).
#
# LOCAL DEVELOPMENT ONLY: when unset in the development environment, a single
# public client "hatef-nextjs-app" is seeded automatically. Outside development
# this variable is REQUIRED and injected by the KMS (Infisical).
# Examples:
#   Public (PKCE) client:
#     OIDC_CLIENTS_JSON=[{"client_id":"hatef-nextjs-app","redirect_uris":["https://hatef.ir/callback"],"token_endpoint_auth_method":"none","allowed_scopes":["openid","profile","email","offline_access"]}]
#   Confidential (private_key_jwt) client — note the embedded public "jwks":
#     OIDC_CLIENTS_JSON=[{"client_id":"search-core","redirect_uris":["https://search.hatef.ir/callback"],"token_endpoint_auth_method":"private_key_jwt","allowed_scopes":["openid","search.full"],"jwks":{"keys":[{"kty":"EC","crv":"P-256","kid":"search-core-2026","x":"f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU","y":"x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"}]}}]
OIDC_CLIENTS_JSON=

# --- WebAuthn / Passkeys (Tasks 4.2, 4.3) -----------------------------------

# None of these are secrets — the browser sees every one of them — but a wrong
# value silently breaks every passkey ceremony, so they are validated at
# startup. Outside development WEBAUTHN_RP_ID and WEBAUTHN_RP_ORIGINS are
# REQUIRED (and injected by the KMS/Infisical alongside the other deployment
# settings); the localhost defaults below only apply in development, where
# browsers exempt http://localhost from the secure-context rule.
#
# The Relying Party ID is the bare registrable domain credentials are bound to:
# NO scheme, port, or path (e.g. "identity.hatef.ir"). It must be a registrable
# suffix of every origin below. Changing it invalidates every existing passkey.
WEBAUTHN_RP_ID=localhost
# Human-palatable RP name shown in the authenticator / platform passkey UI.
WEBAUTHN_RP_DISPLAY_NAME=Hatef Identity
# Comma-separated allow-list of full origins permitted to run a ceremony;
# matched exactly (scheme + host + port). Outside development every entry MUST
# be https, e.g. WEBAUTHN_RP_ORIGINS=https://identity.hatef.ir,https://hatef.ir
WEBAUTHN_RP_ORIGINS=https://localhost:8443
# How long a generate-options challenge stays valid before the matching verify
# must arrive. Kept short to bound the replay window; capped at 15m.
WEBAUTHN_CHALLENGE_TTL=5m
# Shared REDIS_URL stores webauthn:challenge:v1:<sha256 challenge>. Operations
# have fixed 2s deadlines and a 64-KiB serialized-state bound; flow/account/session
# and applicable DPoP bindings are checked atomically before single-use deletion.
# Anonymous login options/verify and reclaim options share 30 requests/IP subnet/
# minute, including nonce challenge/retry. No extra environment toggle bypasses it.
# Optional credential names are frozen in pending registration state, not audit.
# Default userVerification requirement: required | preferred | discouraged.
# "required" forces a PIN/biometric on every ceremony (true single-factor
# passwordless); "preferred" lets the authenticator decide.
WEBAUTHN_USER_VERIFICATION=preferred
# residentKey requirement at registration: required | preferred | discouraged.
# "required" mints discoverable (resident) credentials, which is what makes
# usernameless login work — the authenticator can offer the key without being
# told which account to look for. Weakening this silently pushes users onto the
# user-named fallback, which cannot be made fully harvesting-proof.
WEBAUTHN_RESIDENT_KEY=required
# Constant-time budget for POST /auth/webauthn/login/generate-options on the
# user-named path. Both the real and the decoy branch are padded to this, so the
# response time cannot reveal whether the email is registered. Capped at 2s.
WEBAUTHN_NAMED_LOGIN_FLOOR=150ms
# SECRET (KMS/Infisical-injected, min 32 bytes, base64 or literal): derives the
# stable decoy credential IDs returned when a user-named login names an identity
# that cannot sign in. Required outside development; in development a random
# per-process key is generated. Rotating it only changes the decoys, so it is
# safe to rotate at any time.
# WEBAUTHN_MOCK_CHALLENGE_KEY=

# --- SMS OTP Phone Verification (Task 4.5) ----------------------------------
# SMS is independently optional. Disabled mode needs no provider secret and
# leaves DB-only factor removal/recovery usable. It never selects a log sender.
# Enabled sends use only SMS.ir VERIFY: fixed POST https://api.sms.ir/v1/send/verify,
# Iranian +989xxxxxxxxx destinations submitted as 9xxxxxxxxx (10 digits), and a named
# six-digit code string preserving leading zeros. No provider/URL switch, stock
# API key or real provider test credentials are supplied here.
SMS_ENABLED=false
SMS_PROVIDER=smsir
# Required when enabled: exactly live or sandbox; production accepts live only.
# Owned local HTTPS sinks are not evidence of a real SMS.ir sandbox run.
SMS_IR_KEY_MODE=
SMS_GATEWAY_API_KEY=
SMS_IR_TEMPLATE_ID=
# Positive template ID; required template parameter name without #.
SMS_IR_CODE_PARAMETER=
# Signup requires explicit finite global send budget and a pending cap equal to
# REGISTRATION_PENDING_CAPACITY. These are safety bounds, not approved budgets.
SMS_OTP_GLOBAL_PER_DAY=
SMS_OTP_MAX_PENDING_SIGNUP=
#
# The following existing limits are safety defaults, not budget approval. Durations use
# Go duration syntax (e.g. 3m, 15m); the rate limits and attempt cap are
# positive integers.
#
# Pending OTP lifetime before it expires and a new code must be requested.
SMS_OTP_CODE_TTL=3m
# Failed-verification attempts tolerated before the code is purged and the phone
# is locked out.
SMS_OTP_MAX_ATTEMPTS=3
# Brute-force lockout duration applied after MAX_ATTEMPTS failures.
SMS_OTP_LOCKOUT_TTL=15m
# Per-phone send limits: a 1/min burst guard AND a 5/hour cap (both enforced).
SMS_OTP_PER_PHONE_PER_MINUTE=1
SMS_OTP_PER_PHONE_PER_HOUR=5
# Per-subnet send limit: 10/hour, grouping IPv4 to /24 and IPv6 to /48 so an
# attacker rotating addresses within one allocation shares a single bucket.
SMS_OTP_PER_SUBNET_PER_HOUR=10
#
# REQUIRED when enabled (operator-injected): a pepper mixed (HMAC-SHA-256) into
# stored OTP hashes so a Redis snapshot alone cannot be brute-forced offline
# within the short TTL. Base64-encoded; it must decode to >=16 bytes.
# Generate with: openssl rand -base64 32
SMS_OTP_HASH_PEPPER=

# --- New-account registration (separately opt-in) -----------------------------
# Existing owned Unicode email + Iranian phone + resident UV-required passkey.
# No mailbox/password/role/session is provisioned; completion requires normal login.
# Enabled registration requires SMS_ENABLED=true with explicit live key selection;
# standalone nonproduction SMS may select sandbox, which sends no handset message.
REGISTRATION_ENABLED=false
# Required when enabled: 1..10000 pending, 1..100000 daily, 1..10 per-email hourly.
# No usable public default is supplied; ceilings are not approved operator budgets.
REGISTRATION_PENDING_CAPACITY=
REGISTRATION_GLOBAL_DAILY_LIMIT=
REGISTRATION_EMAIL_HOURLY_LIMIT=
# Dedicated authenticated verified TLS submission: implicit TLS or STARTTLS only.
# Strict post-TLS EHLO must advertise SMTPUTF8 before any EAI AUTH/envelope/DATA.
# FROM/auth values remain ASCII; PUBLIC_ORIGIN exactly matches PORTAL_ORIGIN.
# Durable pending/email/passkey/receipt validity is 15m/10m/at-most-5m/1h.
# Relay acceptance is not inbox delivery; ambiguous sends can duplicate mail.
REGISTRATION_SMTP_HOST=
REGISTRATION_SMTP_PORT=
REGISTRATION_SMTP_TLS_MODE=starttls
REGISTRATION_SMTP_USERNAME=
REGISTRATION_SMTP_PASSWORD=
REGISTRATION_SMTP_FROM=
# Positive and at most 5s; never increase request deadlines for submission.
REGISTRATION_SMTP_TIMEOUT=5s
REGISTRATION_SMTP_CA_BUNDLE=
REGISTRATION_SMTP_PUBLIC_ORIGIN=https://localhost:8443
# Dedicated actual DB cleanup login, no API/SMS/mail/encryption secret dependency.
# Packaged registration-cleanup [once|check] has a 30s total invocation bound,
# not a poll interval. check is nonmutating actual-login/schema validation;
# once runs one bounded batch (1..500). Enabled API also needs this dedicated DSN
# for the no-mutation privilege probe; supervision remains an external gate.
# Hold-aware cleanup does not extend pending/proof/receipt validity.
REGISTRATION_CLEANUP_DATABASE_URL=
REGISTRATION_CLEANUP_BATCH_SIZE=100

# --- Recovery (Backup) Codes (Task 4.6) -------------------------------------
# One-time recovery codes are the last-resort factor when every registered
# passkey and the TOTP authenticator are unavailable. They are high-entropy
# values hashed with SHA-256 (HMAC-SHA-256 when a pepper is set) — never
# Argon2id, which would hand an attacker a CPU-exhaustion vector on the verify
# path and break the O(1) indexed lookup. Verification and the row's physical
# deletion happen inside one ACID transaction under FOR UPDATE, so a code can
# never be spent twice. The routes require DATABASE_URL (above); without it they
# stay unmounted.
#
# All of the following are non-sensitive tunables with production-safe defaults
# (shown), so they only need to be set to override policy. All are positive
# integers.
#
# Codes minted per batch. Regenerating destroys the previous batch atomically,
# so exactly one batch is ever live.
RECOVERY_CODES_COUNT=10
# The portal displays returned plaintext once, only in view memory. Copy/Download
# are explicit; Done/navigation/pagehide/session loss or five minutes clears it
# (also bounded by absolute session expiry). There is no old-plaintext GET/cache,
# no viewer-lifetime environment override, and no silent regeneration after an
# uncertain response. Clipboard/download copies remain the user's responsibility.
# Per-code entropy budget, rounded up to whole Crockford base32 characters
# (5 bits each), so 160 bits is exactly 32 characters. Values below 128 are
# REJECTED at startup rather than silently raised — the floor is mandated and
# must not be weakened by misconfiguration. Note the singular CODE_ here.
RECOVERY_CODE_ENTROPY_BITS=160
# Remaining-code count at or below which the status endpoint reports "low",
# prompting the UI to nudge a regeneration.
RECOVERY_CODES_LOW_THRESHOLD=3
# Generate/verify attempts allowed per hour, applied per operation under
# independent keys. The subnet window is checked before the account window so a
# saturated proxy cannot burn a targeted account's budget.
RECOVERY_CODES_PER_ACCOUNT_PER_HOUR=10
RECOVERY_CODES_PER_SUBNET_PER_HOUR=20
#
# OPTIONAL SECRET (KMS/Infisical-injected): a pepper that keys the stored code
# hash (HMAC-SHA-256) so a stolen database dump alone is not enough to test
# candidate codes offline — the attacker also needs this secret. A single
# service-wide value, not a per-row salt, so the hash stays deterministic and
# therefore indexable. Base64-encoded; when set it must decode to >=16 bytes.
# Rotating it invalidates every existing code, so users must regenerate.
# Generate with: openssl rand -base64 32
# RECOVERY_CODES_HASH_PEPPER=

# -----------------------------------------------------------------------------
# Step-up Authentication (Task 4.7)
# -----------------------------------------------------------------------------
# High-risk endpoints require a short-lived, single-use grant asserting the ACR
# https://ref.hatef.ir/acr/stepup, presented in the X-Step-Up-Auth header. The
# grant is a compact JWS signed by the OIDC keystore configured above. Redis
# single-use claims use a separate HMAC key so their names do not expose grant
# JTIs, account identifiers, or guessable TOTP-derived values.
#
# The ACR value itself is NOT configurable: it is a protocol identifier shared
# with clients, and a per-deployment value would invalidate in-flight grants
# during a rolling deploy for no benefit.
#
# SECRET (KMS/Infisical-injected): standard base64 that decodes to at least 32
# random bytes. Required outside explicit development and identical on every
# replica. Generate with: openssl rand -base64 32
# Never rotate this through a mixed-key rolling deployment: drain protected
# traffic, wait at least the maximum replay lifetime (currently 5m), and cut all
# replicas over together. See docs/devops-operations.md §2.2.
STEPUP_REPLAY_HMAC_KEY=
#
# The service needs DATABASE_URL plus REDIS_URL and this replay key outside
# development. Missing production dependencies prevent startup; when the service
# is deliberately absent in development, every Step-up-gated route stays
# unmounted. An individual account without a passkey or TOTP receives
# no_stepup_factor; no failure mode makes a protected route reachable ungated.
# Currently gated: POST /api/v1/auth/mfa/generate,
# DELETE /api/v1/auth/mfa,
# POST /api/v1/auth/recovery-codes/generate,
# POST /api/v1/auth/webauthn/register/generate-options,
# PATCH /api/v1/auth/webauthn/keys/{id},
# DELETE /api/v1/auth/webauthn/keys/{id},
# POST /api/v1/users/me/phone/send-code,
# DELETE /api/v1/users/me/phone.
# Their same-session completion endpoints consume bound pending enrollment state
# and intentionally do not require a second Step-up grant.
#
# Grant lifetime. Every document describing the window says "3-5 minutes"
# (docs/architecture.md, docs/api-design.md §1.3, docs/frontend-pages.md §5.3),
# so a value above 5m is REJECTED at startup: configuration may harden the
# published contract but must not weaken it. Grants are also single-use, so this
# is only the outer bound on how long an unspent one stays valid.
STEPUP_TOKEN_TTL=5m
# Verification attempts allowed per window. The subnet window is checked before
# the account windows so a saturated shared proxy cannot burn a targeted
# account's budget. The per-minute account window is the one that keeps a
# 6-digit TOTP passcode out of brute-force reach, so lower it rather than raise
# it. Requires REDIS_URL; without Redis (development only) verification is not
# rate limited at all.
STEPUP_VERIFY_PER_ACCOUNT_PER_MINUTE=5
STEPUP_VERIFY_PER_ACCOUNT_PER_HOUR=20
STEPUP_VERIFY_PER_SUBNET_PER_HOUR=40

# -----------------------------------------------------------------------------
# GDPR / Privacy (Tasks 5.1 and 7.4)
# -----------------------------------------------------------------------------
# New requests require fresh WebAuthn UV and remain disabled until a supervised
# SMTP worker, sender/provider policy, and independent recovery mailbox access
# after IdP deactivation have been verified. Disabling this switch does not disable
# anonymous recovery or draining accepted notification intents.
GDPR_DELETION_ENABLED=false
# Deletion, auth_version advancement, hashed reclaim request and encrypted notice
# intents commit together. Live validation rejects old sessions/tokens even after
# recovery; offline JWT-only consumers retain the token's residual lifetime.
# Production requires exactly 720h. Explicit development/test may use at least 24h.
# Retries and legal holds never restart the original recovery clock. The existing
# purge-worker erases eligible Class A data under the legal-hold checks.
GDPR_GRACE_PERIOD=720h
# Subjects one worker run considers. Each is purged in its own transaction, so
# this bounds the run's duration, not any single transaction. When a run reports
# considered == batch size, more subjects are waiting.
GDPR_PURGE_BATCH_SIZE=100
# Dry run: perform every read and legal-hold decision, log the intended outcome,
# and roll back without deleting or enqueuing an event. Use it to validate a
# cutoff change against production data before arming the worker.
GDPR_PURGE_DRY_RUN=false
# Failed factor checks one reclaim request tolerates before it is retired. A wrong
# factor deliberately does NOT consume the reclaim token — that would destroy the
# account's only recovery path — so this cap, not single use, is what bounds brute
# force against the ceremony.
GDPR_RECLAIM_MAX_ATTEMPTS=5
# Reclaim attempts allowed per window. The subnet window is checked first so a
# saturated shared proxy cannot burn a targeted account's budget. Requires
# REDIS_URL; without Redis (development only) reclaim is not rate limited.
GDPR_RECLAIM_PER_ACCOUNT_PER_HOUR=10
GDPR_RECLAIM_PER_SUBNET_PER_HOUR=20
# Deletion requests allowed per account per day. The endpoint is idempotent, so
# this is an abuse bound rather than a correctness one.
GDPR_DELETE_PER_ACCOUNT_PER_DAY=3
# Automatic delivery retries reuse the same token/deadline. There is no public
# resend endpoint: pending accounts cannot call authenticated DELETE again.
# Separate deletion-notifier [run|once] process. Use the restricted delivery role
# documented in devops-operations.md, never a schema-owner/API login.
DELETION_NOTIFIER_DATABASE_URL=
DELETION_NOTIFIER_BATCH_SIZE=50
DELETION_NOTIFIER_CONCURRENCY=4
DELETION_NOTIFIER_POLL_INTERVAL=5s
DELETION_NOTIFIER_LEASE_DURATION=1m
DELETION_NOTIFIER_RETRY_BASE=30s
DELETION_NOTIFIER_RETRY_MAX=1h
DELETION_NOTIFIER_STARTUP_TIMEOUT=15s
# Required authenticated relay, bare sender and canonical HTTPS portal origin.
# Sender/auth values are ASCII; EAI recipients require strict post-TLS SMTPUTF8
# advertisement before AUTH/envelope/DATA. No ASCII downgrade of a Unicode mailbox.
# Credentials are needed only by the worker. PUBLIC_ORIGIN must match PORTAL_ORIGIN
# with no path/query/fragment or trailing slash; it is never taken from request Host.
DELETION_SMTP_HOST=
DELETION_SMTP_USERNAME=
DELETION_SMTP_PASSWORD=
DELETION_SMTP_FROM=
DELETION_SMTP_PUBLIC_ORIGIN=
# starttls requires verified STARTTLS; implicit connects over verified TLS first.
# Empty PORT selects 587 for starttls or 465 for implicit. No plaintext fallback.
DELETION_SMTP_TLS_MODE=starttls
DELETION_SMTP_PORT=
DELETION_SMTP_TIMEOUT=15s
# Optional trusted PEM CA bundle for a private relay; never disables verification.
DELETION_SMTP_CA_BUNDLE=
# API/worker share the existing ENVELOPE_MASTER_KEK and version. Preserve required
# versions while pending or legally held ciphertext remains. Relay acknowledgement
# is not inbox delivery; alert on old pending work, permanent failures and bounces.

# -----------------------------------------------------------------------------
# Audit Pipeline (Task 5.2)
# -----------------------------------------------------------------------------
# Request handlers never write audit rows themselves. They publish an envelope to
# NATS JetStream and return; a single-threaded worker (cmd/audit-signer) drains the
# stream, computes the tamper-evident hash chain, and batch-writes both
# mvp_audit_logs (Class C) and security_event_ledger (Class B) in one transaction.
#
# WHY A SINGLE WRITER: canonical v2 computes leaf_hash(N) = SHA-256(leaf_prefix ||
# serialize(record(N))), then chain_hash(N) = SHA-256(chain_prefix ||
# chain_hash(N-1) || leaf_hash(N)). Prefixes are chain-specific and NUL-terminated.
# Both append-only chain tables retain event IDs/digests after payload erasure.
# Appending is inherently serial, so exactly one process may hold
# the chain tip. The worker takes a PostgreSQL advisory lock and exits if it cannot
# get it — two concurrent signers would interleave and produce a chain that fails
# verification. Scaling this component out is therefore not a configuration change.
#
# LOSS MODEL: publishing is asynchronous and never blocks or fails a request. If
# the buffer is full or NATS is unreachable, the event is written to stdout as a
# single ERROR line containing the full envelope plus an "audit_transport_failure"
# marker — recoverable from log shipping, but it will NOT be in the hash chain.
# Alert on that marker.
#
# Stream name. Changing it points the pipeline at a different (initially empty)
# stream; the previous stream's backlog is not migrated.
AUDIT_STREAM_NAME=IDENTITY_AUDIT
# Subject events are published to. It MUST start with "identity.audit." because
# that is the subject space bound to the stream. A subject outside it is rejected
# at startup: publishing into an unbound subject would leave a healthy-looking
# service with a permanently empty ledger.
AUDIT_SUBJECT=identity.audit.logs
# Durable pull-consumer name. Changing it does NOT rename the consumer — it creates
# a new one that starts at the beginning of the stream, i.e. a deliberate replay.
AUDIT_CONSUMER_NAME=audit-signer
# Depth of the API process's in-memory publish buffer: the burst absorber between
# handlers and the network. Once it is full, events take the log-fallback path
# above rather than blocking the request.
AUDIT_PUBLISH_BUFFER=4096
# Batch policy: flush every AUDIT_FLUSH_INTERVAL or AUDIT_BATCH_SIZE records,
# whichever comes first (docs/data-architecture.md §4.2).
AUDIT_BATCH_SIZE=1000
AUDIT_FLUSH_INTERVAL=5s
# Hard cap on the stream's on-disk size (bytes; default 512 MiB). The stream is
# bounded by size and never by age: an age limit would silently destroy unsigned
# audit records during any signer outage longer than the window. When the cap is
# reached the stream rejects new publishes (loud, recoverable via the fallback log)
# instead of evicting unprocessed records (silent and permanent).
AUDIT_STREAM_MAX_BYTES=536870912
# How long JetStream waits for an ack before redelivering a batch. It must exceed
# AUDIT_FLUSH_INTERVAL plus the signer's 30s batch timeout, and that relationship is
# enforced at startup: a shorter value makes the server redeliver batches that are
# still committing, which looks like a database fault rather than a misconfiguration.
AUDIT_ACK_WAIT=60s
# Redelivery attempts before the message is quarantined. On the final attempt the
# signer writes a synthesized audit record describing the loss (so the gap itself is
# auditable) and then terminates the original message.
AUDIT_MAX_DELIVER=5
# security_event_ledger.retain_until, relative to each event's occurrence time.
# REJECTED outside 4320h-13140h (~6-18 months, docs/compliance-and-data-governance.md
# §3, §7). These are implementation bounds, not legal approval of any duration.
# 8760h = 365 days, neither the 4320h (180-day) minimum nor the 13140h (547.5-day)
# maximum. Actual purpose/legal basis/notices and numeric policy remain gates.
# This is independent of
# GDPR_GRACE_PERIOD, which is a user-recovery window, not a retention policy.
SECURITY_LEDGER_RETENTION=8760h

# --- Security Ledger Retention Purge (Task 5.4) -------------------------------
# Dedicated non-owner/non-superuser login identity_ledger_purge. REQUIRED by this
# command only; no fallback to DATABASE_URL. Provision and bootstrap explicitly
# using docs/admin-operations.md before running, even in dry-run mode. Never use
# the local Compose database-owner credential above. Inject the DSN from Infisical.
SECURITY_LEDGER_PURGE_DATABASE_URL=
# Candidate rows per transaction: 1..5000. Bounds apply even for one large account.
SECURITY_LEDGER_PURGE_BATCH_SIZE=500
# Maximum considered rows per run: at least BATCH_SIZE, at most 1000000.
SECURITY_LEDGER_PURGE_MAX_ROWS=10000
# Whole-run timeout: 1s..30m. Lock waits are 2s; batches are bounded to 15s.
SECURITY_LEDGER_PURGE_TIMEOUT=2m
# Keep true until all rollout gates pass. Rolls back deletion, erasure annotations and
# outbox writes together; reports would_delete rather than committed deletions.
SECURITY_LEDGER_PURGE_DRY_RUN=true
# Uses the existing AUDIT_SUBJECT=identity.audit.logs above, not
# NATS_AUDIT_SUBJECT. Must match protected DB settings, signer and admin publisher.
# This command needs no NATS_URL, Redis, API config, pepper or encryption keys.
# Emits structured JSON at the existing workers' default info level.
# Ordinary DELETE grants do not enforce retention/hold predicates against a
# compromised purge credential; the trusted Go worker performs bounded rechecks.
# Receipt intent is durable at commit, not chained at PubAck/published_at.
# Admin publisher startup requires enabled event_outbox RLS + exactly configured-
# subject/admin_action SELECT/UPDATE policies and four delivery-column grants.
# Other non-owner outbox producers/readers need own reviewed policies before RLS
# activation; this does not enforce purge retention/holds or authorize policy.
# Separate read-only admin-legal --operation=ledger-receipts credentials, never
# purge/API DATABASE_URL fallback. SELECT-only on erasures, receipt outbox and
# Class C payload/chain/head; no encryption keys or evidence-writing privileges.
LEDGER_RECEIPTS_DATABASE_URL=

# Task 5.3 admin REST: disabled until explicit policy and operational gates pass.
ADMIN_ENABLED=false
ADMIN_ALLOWED_ORIGINS=
# Governance-approved durations; no invented production defaults.
# Empty while admin is disabled; explicit zero durations are invalid input.
ADMIN_CONTEXT_RETENTION=
ADMIN_LEGAL_RELEASED_RETENTION=
# Immutable externally approved baseline installed by the controlled operator.
# A UUID or positive duration alone is not evidence of approval.
ADMIN_GOVERNANCE_POLICY_ID=
# Requires a separate workflow extension with explicit case retention clocks,
# numeric durations and acceptance of the actual replay-tombstone inventory.
# Supported lifetime is exactly no_expiry, not legal approval of every permanent
# record. Hold-review stubs join hold tombstones; case sentinels, report/replay and
# governance provenance, both event-ID/digest chains and erasure/receipt metadata
# retain their own actual inventories/lifetimes. See data-architecture.md inventory.
# No production policy or workflow retention is supplied by this example.
LEGAL_WORKFLOW_ENABLED=false
LEGAL_WORKFLOW_POLICY_ID=
# admin-legal maintenance remains explicit and separately scoped:
# cleanup --limit 1..1000; workflow-cleanup --limit 1..500 (--dry-run only
# here); workflow-status --limit 1..1000 loads persisted baseline via DATABASE_URL
# with intake disabled, no keys/actor config, and emits aggregate lower-bound
# backlog/review counts + age/as_of only. --policy-file is policy-install-only;
# lookup-probe/policy-install reject --limit. Unsupported flags fail before DB.
# Fresh baseline cutover: stop old intake/writers -> explicitly scoped fresh
# PostgreSQL + matching fresh/isolated Redis/NATS -> migrate up -> operator-only
# roles/policy/genesis provisioning, key inventory and real signer probe -> compatible
# every-replica/caller restart only after existing approval/manual/production gates.
# Obsolete legal Backfill/plaintext compatibility is removed; unexpected retained
# schema/key/binding inventories fail closed, never create compatibility columns.
# Unchanged 00001 + additive 00002 is forward-only; no legacy adoption, proof-format
# conversion, Down/reset or automatic existing-environment wipe is authorized.
ADMIN_REQUEST_TIMEOUT=5s
ADMIN_PER_ACTOR_PER_MINUTE=60
ADMIN_PER_SUBNET_PER_MINUTE=120
ADMIN_PAGE_SIZE_DEFAULT=50
ADMIN_PAGE_SIZE_MAX=200
ADMIN_AUDIT_MAX_WINDOW=744h
ADMIN_CHAIN_VERIFY_MAX_LIMIT=5000
# Output of the deployed signer lookup-probe; omit to leave attribution unmounted.
ADMIN_LOOKUP_FIXTURE_ID=
# Operator-only launcher values; never pass through API/container user input.
ADMIN_OPERATOR_ID=
ADMIN_OPERATOR_SPIFFE_ID=
